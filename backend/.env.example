# ============================================
# Database
# ============================================
# For Docker Compose: postgresql+psycopg2://postgres:Postgres123@postgres:5432/sentellent
# For local development: postgresql+psycopg2://postgres:your_password@localhost:5432/sentellent
# Or use SQLite for local development: sqlite:///./app.db
DATABASE_URL=postgresql+psycopg2://postgres:Postgres123@postgres:5432/sentellent

# ============================================
# Authentication
# ============================================
# Secret key for JWT token signing - change in production
SECRET_KEY=change-me-in-production
# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Google OAuth
# ============================================
# Google OAuth client ID for Google authentication
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id

# ============================================
# Gemini
# ============================================
# Google Gemini API key for AI services
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# OpenAI
# ============================================
# OpenAI API key (optional, for alternative AI services)
OPENAI_API_KEY=your-openai-api-key

# ============================================
# Qdrant
# ============================================
# Qdrant vector database URL
QDRANT_URL=http://localhost:6333
# Qdrant API key (if authentication is enabled)
QDRANT_API_KEY=your-qdrant-api-key

# ============================================
# Finnhub
# ============================================
# Finnhub API key for stock market data
FINNHUB_API_KEY=your-finnhub-api-key

# ============================================
# Alpha Vantage
# ============================================
# Alpha Vantage API key for financial data
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# ============================================
# Application Settings
# ============================================
# Project name
PROJECT_NAME=Sentellent AI Equity Analyst
# API version
API_VERSION=v1
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
